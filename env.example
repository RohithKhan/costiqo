# Copy this file to .env for local development.
# Keep real third-party credentials and production origins out of git.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./local-dev.db
NEON_DATABASE_URL=
SECRET_KEY=change-this-to-a-long-random-secret-before-deploy

AUTO_CREATE_SCHEMA=true
BOOTSTRAP_VENDORS_ON_STARTUP=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60

ENABLED_SOURCES_RAW=amazon,flipkart,poorvika,reliance-digital,croma,moglix,robu,electronicscomp,ibo,global-electronics
DEGRADED_SOURCES_RAW=
PRIMARY_SOURCES_RAW=amazon,flipkart,poorvika,reliance-digital,croma,moglix,robu,electronicscomp,ibo,global-electronics
BACKGROUND_SOURCES_RAW=

SCRAPE_CACHE_TTL_SECONDS=900
BACKGROUND_SCRAPE_CACHE_TTL_SECONDS=3600
SCRAPE_RETRY_ATTEMPTS=2
SCRAPE_RETRY_BACKOFF_SECONDS=1.0

OFFER_VERIFICATION_ENABLED=true
OFFER_VERIFICATION_TIMEOUT_SECONDS=6
OFFER_VERIFICATION_MAX_OFFERS=2

OPENROUTER_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
LLM_VALIDATION_ENABLED=true
LLM_VALIDATION_TIMEOUT_SECONDS=3
LLM_VALIDATION_MAX_CANDIDATES=12
LLM_VALIDATION_BATCH_SIZE=4
LLM_VALIDATION_PARALLEL_BATCHES=3

QUEUE_BACKEND=inline
QUEUE_NAME=costiqo-scrape
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:7070/api/v1
SCHEDULED_REFRESH_LIMIT=25
